# Telegram Supervisor Bot Configuration
# Copy this section to your .env file and fill in your values

# ============================================================
# TELEGRAM BOT SETUP
# ============================================================

# 1. Get your Telegram Bot Token:
#    - Chat with @BotFather on Telegram
#    - Create a new bot with /newbot
#    - Copy the token (format: 123456789:ABCDefGHIjklMNOpqrsTUVwxyz...)
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# 2. Get your Chat ID:
#    - Chat with @userinfobot on Telegram
#    - Get your Chat ID (numeric, e.g., 123456789)
TELEGRAM_ADMIN_CHAT_ID=YOUR_ADMIN_CHAT_ID_HERE

# ============================================================
# FEATURE FLAGS
# ============================================================

# Enable real-time quarantine alerts
ENABLE_QUARANTINE_ALERTS=true

# Enable admin approval/rejection workflow
ENABLE_APPROVAL_WORKFLOW=true

# Enable daily reports at specified hour
ENABLE_DAILY_REPORTS=true

# ============================================================
# ALERT THRESHOLDS (0-1 scale)
# ============================================================

# Show alerts with threat score above this value
ALERT_THRESHOLD=0.3

# Mark alerts as CRITICAL if threat score exceeds this
CRITICAL_THRESHOLD=0.9

# ============================================================
# TIMING & SCHEDULING
# ============================================================

# What hour to send daily report (UTC, 24h format)
# Example: 9 = 9:00 AM UTC
REPORT_HOUR=9

# Seconds to wait before batching non-critical alerts
# Non-critical alerts are collected and sent as a batch
# Set to 60 for 1-minute batching, 300 for 5-minute batching
ALERT_BATCH_DELAY=60
