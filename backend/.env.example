# Semantic verification layer (optional).
#
# Leave MEMORY_FIREWALL_LLM_API_KEY empty and the firewall runs purely on its
# deterministic rules, exactly as before. Set it and a second, semantic check
# runs on high-risk actions that the pattern rules cleared.
#
# The layer can only tighten a decision. It can never grant authority or
# release an action the authority lattice already blocked, so exposing a model
# to hostile text cannot open a gate.
#
# Get a free key at https://build.nvidia.com (starts with "nvapi-").
MEMORY_FIREWALL_LLM_API_KEY=

# Measured to answer with parseable JSON in ~2-3s. Larger reasoning variants
# exhaust the token budget narrating and return empty content.
MEMORY_FIREWALL_LLM_MODEL=nvidia/nemotron-3-nano-30b-a3b

# Any OpenAI-compatible chat-completions endpoint works.
MEMORY_FIREWALL_LLM_BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions

# Seconds. On timeout a high-risk action is held for review, never allowed.
MEMORY_FIREWALL_LLM_TIMEOUT=12

# WARNING: NVIDIA's free trial endpoints log requests and are not intended for
# confidential data. Keep demos on synthetic fixtures.

# ============================================================
# OPERATOR ALERTS OVER TELEGRAM (optional)
# ============================================================
#
# When both values are set, the firewall sends a plain-text alert to one chat
# every time it blocks or holds a high-risk action. Leave them empty and it
# decides identically; it simply stops narrating itself.
#
# Delivery is best-effort by design. The decision is already made and recorded
# in the ledger by the time the alert is queued, so an unreachable chat can
# never change a verdict, delay a response, or fail a request.
#
# Token from @BotFather. Chat id from @userinfobot. Send /start to your own bot
# once, otherwise Telegram refuses the first message with "chat not found".
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Seconds to wait on the Telegram API before giving up. Default 5.
TELEGRAM_TIMEOUT=5

# Shared secret for the /api/v1/telegram/* management endpoints. Those routes
# are unrelated to the alerts above and stay closed while this is unset.
TELEGRAM_API_KEY=
