# =============================================================
# Backend Environment Variables - TEMPLATE
# Copy this file to `.env` and fill in your OWN values.
# NEVER commit the real .env file (it is git-ignored).
# =============================================================

# Telegram Bot Configuration
# Get your token from @BotFather on Telegram (/newbot)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
# Your Telegram numeric chat id (see ENVIRONMENT_VARIABLES_SAFE.md)
TELEGRAM_ADMIN_CHAT_ID=your-chat-id-here

# API key that protects state-changing POST endpoints
# (send-alert, approvals approve/reject, escalation approve, send-report).
# Generate a strong random value, e.g.: openssl rand -hex 32
# If left empty, those endpoints are DISABLED (fail closed).
TELEGRAM_API_KEY=your-strong-random-api-key-here

# Feature Flags
ENABLE_QUARANTINE_ALERTS=true
ENABLE_APPROVAL_WORKFLOW=true
ENABLE_DAILY_REPORTS=true

# Alert Thresholds
ALERT_THRESHOLD=0.3
CRITICAL_THRESHOLD=0.9

# Timing
REPORT_HOUR=9
ALERT_BATCH_DELAY=60

# CORS Configuration
# Local development: localhost origins
# Production: add your frontend URL (comma-separated)
MEMORY_FIREWALL_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
